# Backdrop — variables d'environnement.
# Copier en .env et remplir. Le .env n'est jamais versionné (section 9.3).

# ---------------------------------------------------------------------------
# Base applicative
# ---------------------------------------------------------------------------
POSTGRES_USER=backdrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backdrop
# 5433 par défaut: un PostgreSQL local occupe souvent déjà 5432 sur la machine
# de développement, et le binding Docker perd silencieusement l'arbitrage.
POSTGRES_PORT=5434

# Port d'écoute de l'application servie par Compose.
WEB_PORT=3100

# Façade HTTPS (Caddy). Fanvue n'accepte que des redirect_uri chiffrés, même
# en développement: c'est cette origine qu'il faut déclarer dans l'app Fanvue,
# et celle que BETTER_AUTH_URL doit désigner.
WEB_HTTPS_PORT=3443

# Port en clair du service web, publié sur la boucle locale uniquement.
# Réservé à l'outillage: l'accès opérateur passe par la façade HTTPS.
WEB_DEBUG_PORT=3110

# --- Déploiement sur serveur -------------------------------------------------
# En développement, laisser `localhost` et `internal`: Caddy signe avec son
# autorité locale et le navigateur avertit une fois.
#
# Sur un réseau local, mettre l'IP de la machine et garder `internal`: Let's
# Encrypt ne certifie pas une adresse privée, Caddy signe donc lui-même.
# Rien n'a besoin d'être exposé, Fanvue compris — la plateforme ne visite
# jamais le redirect_uri, elle y renvoie le navigateur.
#
#   SITE_ADDRESS=192.168.1.50
#   WEB_HTTPS_PORT=443
#   BETTER_AUTH_URL=https://192.168.1.50
#   AUTH_TRUSTED_ORIGINS=https://192.168.1.50
#
# Sur un serveur avec un nom de domaine, mettre le domaine et une adresse
# e-mail de contact: Caddy obtient alors un certificat Let's Encrypt tout seul.
# Le port 80 doit être publié pour la validation ACME.
#
#   SITE_ADDRESS=backdrop.example.com
#   TLS_OPTIONS=ops@example.com
#   WEB_HTTPS_PORT=443
#   ACME_PORT=80
#   BETTER_AUTH_URL=https://backdrop.example.com
#   AUTH_TRUSTED_ORIGINS=https://backdrop.example.com
SITE_ADDRESS=localhost
TLS_OPTIONS=internal
ACME_PORT=8080

# Les deux portes de l'instance: la façade HTTPS et le port en clair.
# Une session ouverte sur l'une doit valoir sur l'autre.
AUTH_TRUSTED_ORIGINS=http://localhost:3100,https://localhost:3443
DATABASE_URL="postgresql://backdrop:change-me@localhost:5434/backdrop?schema=public"

# ---------------------------------------------------------------------------
# Temporal
# ---------------------------------------------------------------------------
TEMPORAL_POSTGRES_PASSWORD=change-me
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---------------------------------------------------------------------------
# Authentification (Better Auth)
# ---------------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# 3100 par défaut: 3000 est fréquemment pris par un autre projet.
BETTER_AUTH_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Chiffrement des credentials plateforme au repos (section 9.2)
# Clé maître AES-256-GCM, 32 octets en base64: openssl rand -base64 32
# Jamais en base, jamais dans le dépôt.
# ---------------------------------------------------------------------------
CREDENTIALS_MASTER_KEY=

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Volume local: source de vérité des Assets et Variants. Jamais servi sur le réseau.
MEDIA_ROOT=./media
# Chemin hôte monté dans les conteneurs. Doit désigner le même répertoire que
# MEDIA_ROOT, sinon le worker dérive des fichiers que le web ne voit pas.
MEDIA_HOST_PATH=./media

# Cloudflare R2: uniquement les Variants SFW destinés à Instagram (section 5).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Laisser vide en production: l'adapter vise alors R2. Renseigné, il pointe un
# stockage S3 local (MinIO) pour exercer la chaîne sans compte Cloudflare.
# R2_ENDPOINT_INTERNAL est la même chose, vue depuis les conteneurs.
R2_ENDPOINT=
R2_ENDPOINT_INTERNAL=

# ---------------------------------------------------------------------------
# Instagram (Instagram API with Facebook Login, app en mode développement)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Version de l API Graph. À relire avant chaque montée de version Meta.
META_GRAPH_VERSION=v25.0
# Laisser vide en production. Renseigné, il pointe un double local du Graph API
# (scripts/dev-graph-stub.ts). META_GRAPH_BASE_INTERNAL est la même chose vue
# depuis les conteneurs.
META_GRAPH_BASE=
META_GRAPH_BASE_INTERNAL=

# ---------------------------------------------------------------------------
# Telegram (MTProto, session utilisateur — un seul couple pour toute l'app, 4.2.1)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Fanvue (OAuth 2.0 + PKCE, 4.3.2)
# ---------------------------------------------------------------------------
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=http://localhost:3100/api/channels/fanvue/callback
FANVUE_API_VERSION=2025-06-26

# ---------------------------------------------------------------------------
# Programmation (section 7.6)
# ---------------------------------------------------------------------------
# Tolérance de retard par défaut, en minutes. Au-delà, la publication passe
# en MISSED et attend une décision de l'opérateur. Surchargeable par ChannelAccount.
SCHEDULE_TOLERANCE_MINUTES=45
