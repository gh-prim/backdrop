# Backdrop — variables d'environnement.
# Copier en .env et remplir. Le .env n'est jamais versionné (section 9.3).

# ---------------------------------------------------------------------------
# Base applicative
# ---------------------------------------------------------------------------
POSTGRES_USER=backdrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backdrop
# 5433 par défaut: un PostgreSQL local occupe souvent déjà 5432 sur la machine
# de développement, et le binding Docker perd silencieusement l'arbitrage.
POSTGRES_PORT=5434
DATABASE_URL="postgresql://backdrop:change-me@localhost:5434/backdrop?schema=public"

# ---------------------------------------------------------------------------
# Temporal
# ---------------------------------------------------------------------------
TEMPORAL_POSTGRES_PASSWORD=change-me
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---------------------------------------------------------------------------
# Authentification (Better Auth)
# ---------------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# 3100 par défaut: 3000 est fréquemment pris par un autre projet.
BETTER_AUTH_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Chiffrement des credentials plateforme au repos (section 9.2)
# Clé maître AES-256-GCM, 32 octets en base64: openssl rand -base64 32
# Jamais en base, jamais dans le dépôt.
# ---------------------------------------------------------------------------
CREDENTIALS_MASTER_KEY=

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Volume local: source de vérité des Assets et Variants. Jamais servi sur le réseau.
MEDIA_ROOT=./media

# Cloudflare R2: uniquement les Variants SFW destinés à Instagram (section 5).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Instagram (Instagram API with Facebook Login, app en mode développement)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Version de l API Graph. À relire avant chaque montée de version Meta.
META_GRAPH_VERSION=v25.0

# ---------------------------------------------------------------------------
# Telegram (MTProto, session utilisateur — un seul couple pour toute l'app, 4.2.1)
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Fanvue (OAuth 2.0 + PKCE, 4.3.2)
# ---------------------------------------------------------------------------
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=http://localhost:3100/api/channels/fanvue/callback
FANVUE_API_VERSION=2025-06-26

# ---------------------------------------------------------------------------
# Programmation (section 7.6)
# ---------------------------------------------------------------------------
# Tolérance de retard par défaut, en minutes. Au-delà, la publication passe
# en MISSED et attend une décision de l'opérateur. Surchargeable par ChannelAccount.
SCHEDULE_TOLERANCE_MINUTES=45
