// Backdrop — schéma applicatif (spec section 8).
//
// ATTENTION: les modèles générés en fin de fichier (User, Organization) portent
// des champs de relation inverse ajoutés à la main, indispensables pour que
// Prisma pose les clés étrangères vers les modèles applicatifs. Ils sont
// balisés « ajouté à la main ». Après un `better-auth generate`, les remettre.
//
// Les modèles d'authentification (User, Session, Account, Verification,
// Organization, Member, Invitation) sont générés par Better Auth et son plugin
// organization. Ils sont ajoutés en fin de fichier par `better-auth generate`
// et ne doivent pas être écrits à la main.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  INSTAGRAM
  TELEGRAM
  FANVUE
}

enum Rating {
  SFW
  SUGGESTIVE
  NSFW
}

/// MISSED: échéance dépassée au-delà de la tolérance de retard (7.6).
/// Ce n'est pas un échec, c'est une décision en attente.

/// DRY_RUN: tout a été vérifié, rien n'a été envoyé. État terminal distinct de
/// PUBLISHED, parce que confondre une simulation avec un envoi réel serait la
/// pire ambiguïté possible dans cette liste.
enum PubStatus {
  DRY_RUN
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MISSED
}

enum PubKind {
  SINGLE
  CAROUSEL
  REEL
  TG_PAID
  FV_POST
  FV_MASS_DM
}

enum SubStatus {
  ACTIVE
  BLOCKED
  DEACTIVATED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Persona {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  handle           String
  timezone         String
  audienceTimezone String?
  /// Ton de voix, niches, vocabulaire interdit.
  bible            Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channels            ChannelAccount[]
  assets              Asset[]
  telegramSubscribers TelegramSubscriber[]
  dmCampaigns         DmCampaign[]
  metricSnapshots     MetricSnapshot[]
  fanvueEarnings      FanvueEarning[]
  telegramApp         TelegramApp?
  albums              Album[]

  @@index([organizationId])
}

/// Identifiants de l'application Telegram, un couple par persona (4.2.1).
///
/// Un `api_id` se crée sur my.telegram.org depuis le compte lui-même: chaque
/// persona génère donc le sien, plutôt que de faire transiter tous les comptes
/// par une application unique — un motif que Telegram surveille.
///
/// Séparé du ChannelAccount parce qu'il le précède: sans api_id, pas de login,
/// donc pas encore de compte connecté à rattacher.
model TelegramApp {
  id          String   @id @default(cuid())
  personaId   String   @unique
  /// Chiffré au repos (AES-256-GCM): { apiId, apiHash }.
  /// Ne sort jamais vers le client (9.7).
  credentials Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

/// Application OAuth Fanvue de l'organisation (4.3.2).
///
/// Une seule app suffit à autoriser plusieurs créatrices — la même paire
/// `client_id` / `client_secret` sert chaque flux d'autorisation, et les
/// jetons qui en sortent appartiennent au ChannelAccount, pas ici.
///
/// Séparée de ChannelAccount parce qu'elle le précède: sans app enregistrée,
/// aucune autorisation n'est possible, donc aucun compte à rattacher. Même
/// raisonnement que TelegramApp (4.2.1).
model FanvueApp {
  id             String   @id @default(cuid())
  organizationId String   @unique
  /// Chiffré au repos (AES-256-GCM): { clientId, clientSecret, redirectUri }.
  /// Ne sort jamais vers le client (9.7).
  credentials    Bytes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ChannelAccount {
  id                       String    @id @default(cuid())
  personaId                String
  platform                 Platform
  /// ig_user_id | chat_id | fanvue account
  externalId               String
  /// Chiffré au repos (AES-256-GCM). Ne sort jamais vers le client (9.7).
  credentials              Bytes
  /// INSTAGRAM => SFW, non modifiable via l'UI.
  maxRating                Rating
  /// Surcharge de la tolérance de retard (7.6). Défaut applicatif: 45 minutes.
  scheduleToleranceMinutes Int?
  tokenExpiresAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  persona      Persona            @relation(fields: [personaId], references: [id], onDelete: Cascade)
  publications Publication[]
  hashtags     InstagramHashtag[]

  @@unique([personaId, platform, externalId])
  @@index([personaId])
}

model Asset {
  id              String   @id @default(cuid())
  personaId       String
  createdByUserId String
  /// Libellé court, interne. Ne part jamais sur une plateforme.
  name            String?
  /// Modifiable, mais sous contrainte: un trigger revalide toutes les
  /// publications qui référencent ce média, et le passage au-dessus de SFW
  /// retire ses Variants de R2 (9.4).
  rating          Rating
  /// Fichier tel qu'uploadé, jamais réécrit: les Variants sont des dérivés.
  localPath       String
  sha256          String
  mimeType        String?
  /// Note libre de l'opérateur. Ne part jamais sur une plateforme.
  description     String?
  /// Métadonnées relevées à l'ingestion, pour ne pas resonder le fichier
  /// chaque fois qu'on veut afficher ses dimensions.
  width           Int?
  height          Int?
  durationMs      Int?
  sizeBytes       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  persona    Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("AssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  variants   Variant[]
  albumItems AlbumItem[]

  @@unique([personaId, sha256])
  @@index([personaId])
}

/// Album de la bibliothèque: un groupe de médias qu'on envoie d'un bloc.
///
/// Il rassemble des **Assets** et non des Variants, parce que le ratio se
/// choisit à l'envoi: « j'envoie cet album en 4:5 ». Grouper des variantes
/// figerait ce choix à la composition de l'album, et interdirait de le
/// réutiliser pour un Reel.
model Album {
  id        String   @id @default(cuid())
  personaId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  persona Persona     @relation(fields: [personaId], references: [id], onDelete: Cascade)
  items   AlbumItem[]

  @@unique([personaId, name])
  @@index([personaId])
}

model AlbumItem {
  id       String @id @default(cuid())
  albumId  String
  assetId  String
  position Int

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  /// `Cascade`: un média supprimé quitte les albums qui le citaient. Un album
  /// pointant vers un média disparu ne vaudrait rien.
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([albumId, assetId])
  @@index([albumId])
  @@index([assetId])
}

model Variant {
  id                String   @id @default(cuid())
  assetId           String
  /// "4:5" | "9:16" | "1:1"
  ratio             String
  localPath         String
  /// Seulement si SFW et destiné à Instagram (section 5).
  r2Key             String?
  /// Pointeur Saved Messages Telegram, jamais le file_reference (4.2.8).
  tgSourceMessageId BigInt?
  /// Media Fanvue après upload multipart, une fois le statut `ready` (4.3.5).
  fvMediaUuid       String?
  createdAt         DateTime @default(now())

  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  publicationItems PublicationItem[]
  dmCampaignItems  DmCampaignItem[]

  @@index([assetId])
}

model Publication {
  id               String    @id @default(cuid())
  channelAccountId String
  createdByUserId  String
  /// Verrou optimiste, édition concurrente (7.4).
  version          Int       @default(0)
  kind             PubKind
  /// Identifiant de l'envoi, partagé par les publications sœurs d'un même
  /// geste multi-canal.
  ///
  /// En base, une publication par canal reste la bonne unité: un échec sur
  /// Instagram ne doit pas emporter Telegram (section 3). Mais à l'écran c'est
  /// **un seul objet** — on programme, annule et archive l'envoi, pas ses
  /// morceaux. Ce champ porte cette dualité.
  groupId          String
  /// Libellé interne, partagé par les publications sœurs. Sert à les nommer,
  /// pas à être publié — et surtout pas à les regrouper: deux envois distincts
  /// peuvent porter le même nom.
  name             String    @default("")
  copy             String    @default("")
  scheduledAt      DateTime
  status           PubStatus @default(DRAFT)
  /// Telegram paid media, en Stars. Réservé aux channels: TDLib refuse
  /// `inputMessagePaidMedia` ailleurs (4.2.6, tranché le 2026-09-10).
  starPrice        Int?
  /// Telegram: destination de l'envoi, channel ou conversation privée.
  targetChatId     String?
  /// Libellé de la destination, figé à la composition. Un channel renommé ou
  /// quitté ne doit pas rendre une publication passée illisible.
  targetLabel      String?
  /// Fanvue, cents USD, minimum 300. Jamais additionné avec starPrice.
  priceCents       Int?
  /// Fanvue: subscribers | followers-and-subscribers
  audience         String?
  /// Fanvue: mediaPreviewUuid, teaser gratuit d'un post payant.
  previewVariantId String?
  /// Fanvue: expiration du post.
  expiresAt        DateTime?
  /// Instagram Audio API, Reels uniquement (4.1.5).
  audioId          String?
  /// Volumes du mixage, 0 à 100. Une piste native rend le Reel visible sur la
  /// page de l'audio; couper le son de la vidéo évite de superposer deux fois
  /// la même musique quand elle est déjà incrustée au montage.
  audioVolume      Int?
  videoVolume      Int?
  remoteId         String?
  failureReason    String?
  publishedAt      DateTime?
  /// Rangée hors de la vue courante, sans être supprimée. Réservé aux états
  /// terminaux: archiver ce qui doit encore partir masquerait un envoi à venir.
  archivedAt       DateTime?
  /// Simulation: le workflow vérifie tout et s'arrête avant l'appel plateforme.
  /// Permet d'éprouver un envoi multi-canal sans rien publier en production.
  dryRun           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  channelAccount  ChannelAccount    @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("PublicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           PublicationItem[]
  metricSnapshots MetricSnapshot[]

  @@unique([channelAccountId, remoteId])
  @@index([channelAccountId, status])
  @@index([scheduledAt])
  @@index([groupId])
}

model PublicationItem {
  id               String  @id @default(cuid())
  publicationId    String
  variantId        String
  position         Int
  /// Container enfant Instagram, transitoire (4.1.4).
  childContainerId String?

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  variant     Variant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([publicationId, position])
  @@index([variantId])
}

/// Hashtag Instagram résolu, mis en cache.
///
/// L'API n'autorise que **30 hashtags uniques par fenêtre de 7 jours et par
/// compte** (4.1.11). Une validation à la frappe épuiserait ce budget en une
/// seule légende: chaque résolution est donc conservée, et un hashtag déjà
/// connu n'est jamais réinterrogé.
model InstagramHashtag {
  id               String   @id @default(cuid())
  channelAccountId String
  /// Sans le croisillon, en minuscules.
  name             String
  /// Identifiant Meta. Null si le hashtag n'existe pas ou est refusé.
  hashtagId        String?
  /// Médiane des likes des top posts: signal de concurrence, pas de volume.
  topMedianLikes   Int?
  /// Sert au décompte du budget hebdomadaire.
  checkedAt        DateTime @default(now())

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, name])
  @@index([channelAccountId, checkedAt])
}

model TelegramSubscriber {
  id        String    @id @default(cuid())
  personaId String
  tgUserId  BigInt
  /// Origine de l'acquisition.
  source    String?
  status    SubStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  persona    Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  deliveries DmDelivery[]

  @@unique([personaId, tgUserId])
  @@index([personaId, status])
}

model DmCampaign {
  id              String    @id @default(cuid())
  personaId       String
  createdByUserId String
  version         Int       @default(0)
  caption         String    @default("")
  starPrice       Int?
  scheduledAt     DateTime
  status          PubStatus @default(DRAFT)
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  persona    Persona          @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("DmCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items      DmCampaignItem[]
  deliveries DmDelivery[]

  @@index([personaId, status])
  @@index([scheduledAt])
}

model DmCampaignItem {
  id         String @id @default(cuid())
  campaignId String
  variantId  String
  position   Int

  campaign DmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([campaignId, position])
  @@index([variantId])
}

model DmDelivery {
  id           String         @id @default(cuid())
  campaignId   String
  subscriberId String
  status       DeliveryStatus @default(PENDING)
  messageId    BigInt?
  failReason   String?
  sentAt       DateTime?

  campaign   DmCampaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber TelegramSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
}

model MetricSnapshot {
  id            String   @id @default(cuid())
  personaId     String
  publicationId String?
  capturedAt    DateTime
  /// Métriques brutes par plateforme.
  payload       Json

  persona     Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([personaId, capturedAt])
  @@index([publicationId])
}

/// Lignes de revenu Fanvue (4.3.11). Transactionnelles et mutables
/// (pendingBalance -> availableForPayout), donc hors MetricSnapshot.

model FanvueEarning {
  id                         String   @id @default(cuid())
  personaId                  String
  transactionOrderId         String
  /// pendingBalance | availableForPayout
  status                     String
  date                       DateTime
  /// Cents USD, négatif sur refund et chargeback.
  grossCents                 Int
  netCents                   Int
  /// post | message | tip | subscription | renewal | refund | chargeback | ...
  source                     String
  /// Attribution au média, absente sur Telegram (4.2.5).
  postUuid                   String?
  messageUuid                String?
  /// Rapproché via Publication.remoteId.
  publicationId              String?
  reversedTransactionOrderId String?
  fetchedAt                  DateTime @default(now())

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, transactionOrderId])
  @@index([personaId, date])
  @@index([postUuid])
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Ajouté à la main: attribution des entités à effet externe (7.4).
  assetsCreated       Asset[]       @relation("AssetCreatedBy")
  publicationsCreated Publication[] @relation("PublicationCreatedBy")
  dmCampaignsCreated  DmCampaign[]  @relation("DmCampaignCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // Ajouté à la main: l'Organization est le tenant, frontière d'isolation (7.4).
  personas  Persona[]
  fanvueApp FanvueApp?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
