# worker-node: activités TypeScript (Instagram, ffmpeg, R2, Fanvue).
# Scalable horizontalement, contrairement au worker Telegram de la phase 2.
FROM node:24-bookworm-slim

# ffmpeg est une dépendance de premier ordre, pas un outil de confort:
# `+faststart` et les recadrages conditionnent l'acceptation des vidéos par
# Instagram (spec 4.1.7).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY prisma ./prisma
RUN pnpm exec prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker

ENV NODE_ENV=production
CMD ["pnpm", "tsx", "worker/index.ts"]
